# Copie este ficheiro para ".env" e substitua os valores. NUNCA envie o ".env" para o GitHub.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de dados: "mysql" (padrão do projeto) ou "sqlite" (apenas para testes rápidos locais)
DB_ENGINE=mysql
DB_NAME=unimarket
DB_USER=unimarket_user
DB_PASSWORD=troque-esta-palavra-passe
DB_HOST=127.0.0.1
DB_PORT=3306
